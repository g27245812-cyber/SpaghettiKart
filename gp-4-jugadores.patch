+/**
+ * Grand Prix with 3 or 4 human players. The remaining characters are CPUs.
+ */
+void spawn_players_gp_four_player(f32* arg0, f32* arg1, f32 arg2) {
+    s16 humans = gPlayerCountSelection1;
+    s16 i;
+    s16 j;
+    s16 k;
+
+    func_80039DA4();
+
+    if ((GetCupCursorPosition() == TRACK_ONE) || (gDemoMode == 1) ||
+        (gDebugMenuSelection == DEBUG_MENU_OPTION_SELECTED)) {
+        s16 count = 0;
+        for (i = 0; i < 8; i++) {
+            s16 taken = 0;
+            for (j = 0; j < humans; j++) {
+                if (gCharacterSelections[j] == i) {
+                    taken = 1;
+                }
+            }
+            if (!taken && count < 7) {
+                chooseCPUPlayers[count++] = i;
+            }
+        }
+        // Shuffle so the CPUs do not always start in character order
+        for (i = count - 1; i > 0; i--) {
+            k = random_int(i + 1);
+            j = chooseCPUPlayers[i];
+            chooseCPUPlayers[i] = chooseCPUPlayers[k];
+            chooseCPUPlayers[k] = j;
+        }
+    }
+
+    for (i = 0; i < 4; i++) {
+        Player* plr = &gPlayers[i];
+        if (i < humans) {
+            spawn_player(plr, i, arg0[D_80165270[i]], arg1[D_80165270[i]], arg2, 32768.0f, gCharacterSelections[i],
+                         PLAYER_EXISTS | PLAYER_START_SEQUENCE | PLAYER_HUMAN);
+        } else {
+            spawn_player(plr, i, arg0[D_80165270[i]], arg1[D_80165270[i]], arg2, 32768.0f,
+                         chooseCPUPlayers[i - humans], PLAYER_EXISTS | PLAYER_CPU | PLAYER_START_SEQUENCE);
+        }
+    }
+    for (i = 4; i < 8; i++) {
+        spawn_player(&gPlayers[i], i, arg0[D_80165270[i]], arg1[D_80165270[i]], arg2, 32768.0f,
+                     chooseCPUPlayers[i - humans], PLAYER_EXISTS | PLAYER_CPU | PLAYER_START_SEQUENCE);
+    }
+
+    D_80164A28 = 0;
+    func_80039AE4();
+}
